body {
    font-family: Arial, Helvetica, sans-serif;
    margin: 0;
    background: #f5f5f5;
    color: #222;
    font-size: 18px;
}


header {
    background: #0b5ea8;
    color: white;
    text-align: center;
    padding: 30px;
}


header h1 {
    margin-bottom: 10px;
    font-size: 36px;
}


header p {
    font-size: 19px;
}


main {
    max-width: 1200px;
    margin: auto;
    padding: 20px;
}


section {
    background: white;
    padding: 20px;
    margin-bottom: 25px;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0,0,0,.08);
}


h2 {
    font-size: 26px;
}


select {
    width: 100%;
    padding: 12px;
    font-size: 18px;
}


iframe {
    display: block;
    width: 100%;
    height: 850px;
    margin: 0 auto;
    border: none;
}



/* Таблица выбранного антибиотика */

#smallTable {
    width: 100%;
}


#smallTable table {
    width: 100%;
    border-collapse: collapse;
    font-size: 17px;
}


#smallTable th,
#smallTable td {
    border: 1px solid #ddd;
    padding: 12px;
    text-align: center;
}


#smallTable th:first-child,
#smallTable td:first-child {
    width: 50%;
}


#smallTable th:last-child,
#smallTable td:last-child {
    width: 50%;
}



/* Полная таблица как в Community Atlas */

#fullTable {
    width: 100%;
    overflow-x: auto;
}


#fullTable table {
    width: 100%;
    min-width: 1200px;
    border-collapse: collapse;
    font-size: 16px;
}


#fullTable th {
    background: #0b5ea8;
    color: white;
    font-size: 17px;
    padding: 14px;
    text-align: center;
    white-space: nowrap;
}


#fullTable td {
    border: 1px solid #ddd;
    padding: 12px;
    text-align: center;
    white-space: nowrap;
}


#fullTable tr:nth-child(even) {
    background: #f8f8f8;
}


#fullTable tr:hover {
    background: #eef6ff;
}



footer {
    text-align: center;
    padding: 20px;
    color: #666;
    font-size: 16px;
}
#fullTable table {
    width: 1500px !important;
    font-size: 25px !important;
}
/* ===== Hospital full table like Community Atlas ===== */

#fullTable {
    width: calc(100vw - 80px);
    overflow-x: auto;
    margin-left: calc(50% - 50vw + 40px);
}


#fullTable table {
    width: 100%;
    min-width: 1400px;
    border-collapse: collapse;
    font-size: 17px;
}


#fullTable th {
    background: #0b5ea8;
    color: white;
    padding: 14px;
    border: 1px solid #ddd;
    text-align: center;
    white-space: nowrap;
}


#fullTable td {
    padding: 12px;
    border: 1px solid #ddd;
    text-align: center;
    white-space: nowrap;
}


#fullTable tr:nth-child(even) {
    background: #f8f8f8;
}


#fullTable tr:hover {
    background: #eef6ff;
}
