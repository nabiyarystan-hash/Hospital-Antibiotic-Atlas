body {
    font-family: Arial, Helvetica, sans-serif;
    margin: 0;
    background: #f5f5f5;
    color: #222;
    font-size: 18px;
}


header {
    background: #0b5ea8;
    color: white;
    text-align: center;
    padding: 30px;
}


header h1 {
    margin-bottom: 10px;
    font-size: 36px;
}


header p {
    font-size: 19px;
}


main {
    max-width: 1200px;
    margin: auto;
    padding: 20px;
}


section {
    background: white;
    padding: 20px;
    margin-bottom: 25px;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0,0,0,.08);
}


h2 {
    font-size: 26px;
}


.center-title {
    text-align: center;
}


select {
    width: 100%;
    padding: 12px;
    font-size: 18px;
}


iframe {
    display: block;
    width: 100%;
    height: 850px;
    margin: 0 auto;
    border: none;
}


table {
    border-collapse: collapse;
    font-size: 17px;
}


#smallTable {
    display: flex;
    justify-content: center;
}


#smallTable table {
    width: auto;
    min-width: 600px;
}


th, td {
    border: 1px solid #ddd;
    padding: 10px;
    text-align: center;
}


th {
    background: #0b5ea8;
    color: white;
    font-size: 18px;
}


#smallTable th,
#smallTable td {
    text-align: center;
}


footer {
    text-align: center;
    padding: 20px;
    color: #666;
    font-size: 16px;
}
